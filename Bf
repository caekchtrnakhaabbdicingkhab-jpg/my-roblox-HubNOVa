function AutoFarmBoss()
	if MonsterBoss == "rip_indra True Form [Lv. 5000] [Raid Boss]" or MonsterBoss == "Order [Lv. 1250] [Raid Boss]" or MonsterBoss == "Soul Reaper [Lv. 2100] [Raid Boss]" or MonsterBoss == "Longma [Lv. 2000] [Boss]" or MonsterBoss == "The Saw [Lv. 100] [Boss]" or MonsterBoss == "Greybeard [Lv. 750] [Raid Boss]" or MonsterBoss == "Don Swan [Lv. 1000] [Boss]" or MonsterBoss == "Cursed Captain [Lv. 1325] [Raid Boss]" or MonsterBoss == "Saber Expert [Lv. 200] [Boss]" or MonsterBoss == "Mob Leader [Lv. 120] [Boss]" or MonsterBoss == "Darkbeard [Lv. 1000] [Raid Boss]" then
		if game:GetService("Workspace").Enemies:FindFirstChild(MonsterBoss) then
			for i,v in pairs(game.Workspace.Enemies:GetChildren()) do
				if Settings["Main"]["Auto Boss Select"] and v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 and v.Name == MonsterBoss then
					repeat wait() 
						if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and (v.HumanoidRootPart.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).magnitude > 350 then
							Farmtween = toTarget(v.HumanoidRootPart.Position,v.HumanoidRootPart.CFrame)
						elseif v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and (v.HumanoidRootPart.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).magnitude <= 350 then
							if Farmtween then Farmtween:Stop() end
							if Settings["Main"]["Auto Haki"] then
								if not game.Players.LocalPlayer.Character:FindFirstChild("HasBuso") then
									game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Buso")
								end
							end
							if not game.Players.LocalPlayer.Character:FindFirstChild(Settings["Main"]["Select Weapon"]) then
								wait()
								EquipWeapon(Settings["Main"]["Select Weapon"])
							end
							StartMagnet = true
							if Settings["Main"]["Type Farm"] == "Above" then
								toTarget(v.HumanoidRootPart.CFrame * CFrame.new(1,Settings["Main"]["Distance Farm Type"],0))
							elseif Settings["Main"]["Type Farm"] == "Under" then
								toTarget(v.HumanoidRootPart.CFrame * CFrame.new(0, - Settings["Main"]["Distance Farm Type"],0))
							elseif Settings["Main"]["Type Farm"] == "Behind" then
								toTarget( v.HumanoidRootPart.CFrame * CFrame.new(0,0,Settings["Main"]["Distance Farm Type"]))
							end
							PosMon = v.HumanoidRootPart.CFrame
							if not Settings["Main"]["Fast Attack"] then
								game:GetService'VirtualUser':CaptureController()
								game:GetService'VirtualUser':Button1Down(Vector2.new(1280, 672))
							end
							v.HumanoidRootPart.Size = Vector3.new(80,80,80)
							if Settings["Main"]["Show HitBox"] then
								v.HumanoidRootPart.Transparency = 0.5
							else
								v.HumanoidRootPart.Transparency = 1
							end
							v.Humanoid.JumpPower = 0
							v.Humanoid.WalkSpeed = 0
							v.HumanoidRootPart.CanCollide = false
							if v.Humanoid:FindFirstChild("Animator") then
								v.Humanoid.Animator:Destroy()
							end
							v.Humanoid:ChangeState(11)
							sethiddenproperty(game.Players.LocalPlayer, "SimulationRadius",  math.huge)
						end
					until not Settings["Main"]["Auto Boss Select"] or not v.Parent or v.Humanoid.Health <= 0
					StartMagnet = false
				end
			end
		else
			StartMagnet = false
			Questtween = toTarget(CFrameBoss.Position,CFrameBoss)
			if MonsterBoss ==  "Don Swan [Lv. 1000] [Boss]" and (CFrameBoss.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).magnitude > 350 then
				if Questtween then Questtween:Stop() end
				game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("requestEntrance",Vector3.new(2284,15,905))
			elseif (CFrameBoss.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).magnitude <= 350 then
				if Questtween then Questtween:Stop() end
				game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrameBoss
				wait(1)
			end 
		end
	else
		if game.Players.LocalPlayer.PlayerGui.Main.Quest.Visible == false and Settings["Main"]["Auto Quest Boss"] == true then
			StartMagnet = false
			CheckQuestBoss()
			Questtween = toTarget(CFrameQuestBoss.Position,CFrameQuestBoss)
			if (CFrameQuestBoss.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).magnitude <= 350 then
				if Questtween then Questtween:Stop() end
				game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrameQuestBoss
				wait(1.1)
				Com("F_","StartQuest", NameQuestBoss, LevelQuestBoss)
			end 
		elseif Settings["Main"]["Auto Quest Boss"] == false then
			if game:GetService("Workspace").Enemies:FindFirstChild(MonsterBoss) then
				for i,v in pairs(game:GetService("Workspace").Enemies:GetChildren()) do
					if Settings["Main"]["Auto Boss Select"] and v.Name == MonsterBoss and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
						repeat wait()
